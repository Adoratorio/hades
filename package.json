{
  "name": "@adoratorio/hades",
  "version": "2.0.0",
  "description": "A smooth scrollbar based on Hermes, scroll down 'till hell",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "src/**/*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build",
    "test:package": "node scripts/check-package.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "keywords": [
    "scroll",
    "smooth",
    "smoothscrollbar",
    "smoothness",
    "hades",
    "adoratorio"
  ],
  "author": "Adoratorio Studio <contact@adoratorio.com>",
  "contributors": [
    "Andrea Gottardi <andrea@adoratorio.com>",
    "Daniele Borra <daniele@adoratorio.com>",
    "Tommaso Algozzino <tommaso@adoratorio.com>",
    "Luca Bortolussi <luca@adoratorio.com>",
    "Darío Hereñú"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adoratorio/hades.git"
  },
  "bugs": {
    "url": "https://github.com/Adoratorio/hades/issues"
  },
  "homepage": "https://github.com/Adoratorio/hades#readme",
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@adoratorio/aion": "^1.0.1",
    "@adoratorio/hermes": "^2.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
